<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" force="true" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" force="true" value="array"/>
        <env name="DB_CONNECTION" force="true" value="mysql"/>
        <env name="DB_DATABASE" force="true" value="exams_test"/>
        <env name="DB_URL" force="true" value=""/>
        <env name="MAIL_MAILER" force="true" value="array"/>
        <env name="QUEUE_CONNECTION" force="true" value="sync"/>
        <env name="SESSION_DRIVER" force="true" value="array"/>
        <env name="API_KEYS" value="" force="true"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
        <!-- Container env vars live in $_SERVER, which Laravel reads first; force these too so
             tests can never run against a real database. -->
        <server name="APP_ENV" value="testing" force="true"/>
        <server name="CACHE_STORE" value="array" force="true"/>
        <server name="DB_CONNECTION" value="mysql" force="true"/>
        <server name="DB_DATABASE" value="exams_test" force="true"/>
        <server name="DB_URL" value="" force="true"/>
        <server name="MAIL_MAILER" value="array" force="true"/>
        <server name="QUEUE_CONNECTION" value="sync" force="true"/>
        <server name="SESSION_DRIVER" value="array" force="true"/>
        <server name="API_KEYS" value="" force="true"/>
    </php>
</phpunit>
